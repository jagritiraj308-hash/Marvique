{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'jagritiraj04@gmail.com'",
      "$productId": {
        ".validate": "!newData.exists() || newData.hasChildren(['id', 'name', 'category'])"
      }
    },
    "customers": {
      ".read": "auth != null && auth.token.email === 'jagritiraj04@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'email'])"
      }
    },
    "orders": {
      ".read": "auth != null && auth.token.email === 'jagritiraj04@gmail.com'",
      ".write": false
    }
  }
}
